<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lendo...</title>
    <style>
        body { font-family: serif; line-height: 1.6; padding: 20px; transition: 0.3s; }
        body.dark { background: #1a1a1a; color: #ccc; }
        .menu { position: fixed; top: 0; width: 100%; background: #333; color: white; left: 0; padding: 10px; display: flex; justify-content: space-between; }
        #texto { margin-top: 50px; white-space: pre-wrap; font-size: 18px; }
    </style>
</head>
<body class="{{ 'dark' if progresso and progresso['dark_mode'] == 1 else '' }}">
    <div class="menu">
        <a href="/" style="color:white">🔙 Sair</a>
        <button onclick="toggleDark()">🌓 Modo</button>
    </div>

    <div id="texto">{{ livro['conteudo'] }}</div>

    <script>
        const idLivro = {{ livro['id'] }};
        // Volta para a posição salva no banco
        window.onload = () => { window.scrollTo(0, {{ progresso['posicao'] if progresso else 0 }}); };

        // Salva a posição sempre que você rolar a tela
        window.onscroll = () => {
            fetch('/salvar_progresso', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({id: idLivro, pos: window.scrollY, dark: document.body.classList.contains('dark') ? 1 : 0})
            });
        };

        function toggleDark() { document.body.classList.toggle('dark'); }
    </script>
</body>
</html>
